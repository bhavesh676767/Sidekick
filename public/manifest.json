{
  "manifest_version": 3,
  "name": "Sidekick",
  "version": "1.0.0",
  "description": "AI browser assistant — control the web with text commands",
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "storage",
    "clipboardWrite",
    "clipboardRead",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://localhost:11434/*"
  ],
  "action": {
    "default_popup": "index.html",
    "default_icon": {
      "16": "sidekick_logo.png",
      "48": "sidekick_logo.png",
      "128": "sidekick_logo.png"
    }
  },
  "icons": {
    "16": "sidekick_logo.png",
    "48": "sidekick_logo.png",
    "128": "sidekick_logo.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    },
    {
      "matches": ["<all_urls>"],
      "js": ["assistant-notch.js"],
      "run_at": "document_idle"
    }
  ]
}
