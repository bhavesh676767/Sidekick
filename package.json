{
  "name": "sidekick-extension",
  "version": "1.0.0",
  "private": true,
  "description": "AI browser assistant extension with a floating on-page command notch.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:libs": "vite build --config vite.sidekick-libs.config.js",
    "build": "npm run build:libs && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "browser-extension",
    "chrome-extension",
    "ai-assistant",
    "ollama",
    "gemini"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "chrono-node": "^2.9.1",
    "compromise": "^14.15.0",
    "currency.js": "^2.0.4",
    "fuse.js": "^7.3.0",
    "linkifyjs": "^4.3.3",
    "localforage": "^1.10.0",
    "lucide-react": "^0.263.1",
    "minisearch": "^7.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/react": "^18.3.29",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.4.14",
    "postcss": "^8.4.24",
    "tailwindcss": "^3.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.14"
  }
}
